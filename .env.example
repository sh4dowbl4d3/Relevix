# Relevix — AI Image Relevance Engine
# Environment Configuration

# Server
PORT=3000
NODE_ENV=development

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5433
DB_NAME=relevix
DB_USER=relevix
DB_PASSWORD=changeme_in_production

# AI Provider Configuration
# Option 1: Gemini (recommended)
GEMINI_API_KEY=your_gemini_api_key_here
VISION_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=text-embedding-004

# Option 2: Ollama (local fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=llava
OLLAMA_EMBEDDING_MODEL=all-minilm

# Use local AI provider instead of Gemini
USE_LOCAL_AI=false

# Mismatch Guard Thresholds
SIMILARITY_THRESHOLD=0.65
CONFIDENCE_THRESHOLD=0.5
LOW_CONFIDENCE_THRESHOLD=0.4

# Budget Guard
DAILY_BUDGET_LIMIT_USD=5.00
MAX_VISION_CALLS_PER_DAY=100
MAX_EMBEDDING_CALLS_PER_DAY=500

# Batch Processing
BATCH_SIZE=10
BATCH_DELAY_MS=1000
MAX_RETRIES=3
